NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production this must be the live https domain (e.g. https://lagecto.co.zw)
# so WhatsApp and other apps can show news and storefront preview cards.

# Google sign-in is enabled in the Supabase dashboard, not in this file.
# Auth > Providers > Google: set the Google Client ID and Client Secret.
# Auth > URL configuration:
#   Site URL = NEXT_PUBLIC_SITE_URL
#   Redirect URLs must include:
#     http://localhost:3000/auth/callback
#     https://<your-domain>/auth/callback
#     https://<project-ref>.supabase.co/auth/v1/callback
STEBO_API_URL=

CRON_SECRET=
# Required in production. Vercel Cron sends Authorization: Bearer $CRON_SECRET
# to /api/cron/loyalty (hourly) and /api/cron/stebo-weekly (Saturday 04:00 UTC).

# Staging should use a separate Supabase project and a separate CRON_SECRET.
# Never reuse production service-role keys in local or staging.

# Marketplace customer checkout is WhatsApp-only for now.
# Set to true later to re-enable Paynow/card collection without rebuilding orders.
# LAGECTO_MARKETPLACE_ONLINE_PAYMENTS=true

# Payments — server only. Never prefix secret keys with NEXT_PUBLIC_.
# Kept for a future online-payments release. Unused by customer checkout today.
# PAYMENT_PROVIDER=sandbox|paynow
# PAYMENT_MODE=test|live
PAYMENT_PROVIDER=sandbox
PAYMENT_MODE=test
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
